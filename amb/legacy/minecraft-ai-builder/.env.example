# ===========================================
# 🚀 Minecraft AI Builder - Environment Config
# ===========================================

# === GENERAL ===
NODE_ENV=development
LOG_LEVEL=INFO

# === BACKEND (FastAPI) ===
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_RELOAD=true
DATABASE_URL=sqlite:///./minecraft_builder.db

# === LLM CONFIGURATION ===
# Primary: Mistral-7B (Local)
MISTRAL_MODEL_PATH=./ml/models/mistral-7b-instruct
MISTRAL_ENABLED=true

# Fallback: Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_ENABLED=true

# === ML SERVICE ===
ML_MODEL_PATH=./ml/checkpoints/transformer_blueprint.onnx
ML_INFERENCE_BATCH_SIZE=1
ML_DEVICE=cpu

# === MINECRAFT AGENT (Node.js) ===
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=BuilderBot
MC_VERSION=1.20.1
MC_AUTH=offline

# === WebSocket ===
WS_BACKEND_URL=ws://localhost:8000/ws
WS_RECONNECT_INTERVAL=5000
WS_MAX_RETRIES=10

# === FRONTEND ===
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# === SECURITY ===
SECRET_KEY=018e9302c6164f04ceb4e7afcbd733b7efc70d04cc542042e3d5c2513baf98e0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === BARITONE ===
BARITONE_ENABLED=true
BARITONE_PATH_TIMEOUT=30000

# === LOGGING ===
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5