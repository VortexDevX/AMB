# Minecraft Server
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=BuilderBot
MC_VERSION=1.20.1

# Backend WebSocket
WS_BACKEND_URL=ws://localhost:8000/ws/agent
WS_RECONNECT_INTERVAL=5000
WS_MAX_RETRIES=10

# Bot Behavior
BOT_VIEW_DISTANCE=tiny
BOT_CHAT_ENABLED=true
BOT_DEBUG=true

# Build Settings
MAX_BLOCKS_PER_SECOND=10
PLACEMENT_DELAY=100